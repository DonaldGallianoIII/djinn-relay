+# Djinn Relay config for djinn-relay itself, so the plugin can review its own
+# changes. The plugin is markdown prompts, not code: reviewers read the
+# commands, agents and CONTRACTS.md for contradictions, broken references,
+# and instructions an agent would misread.
+
+base_branch: Claude-Development-djinn-relay
+
+build_cmd: none
+test_cmd: none
+
+known_bugs_index: ~/Conventions/code/KNOWN-BUGS.md
+
+conventions_files:
+  - plugins/djinn/CONTRACTS.md
+  - ~/Conventions/CLAUDE.md
+
+hot_paths: []
+
+goal_doc: none
+
+deps:
+  manifests: []
+  lockfiles: []
+  list_cmd: none
+  check_cmd: none
+  platform: none
+  coupled_sets: []
+  landmines: []
+
+project_notes: |
+  djinn-relay is a Claude Code marketplace plugin made only of markdown:
+  commands/*.md are orchestration prompts the main session follows,
+  agents/*.md are subagent definitions, CONTRACTS.md is the interface every
+  prompt must honor ("when a prompt and CONTRACTS.md disagree, CONTRACTS.md
+  wins"). There is no code and no build. A defect here is a prompt that
+  contradicts the contract or another prompt, a reference to a section,
+  file or field that does not exist, or an instruction an agent will
+  predictably misread. Version 2.2.0 adds findings.json (CONTRACTS.md
+  section 12), written by the synthesis agent every round, and a read-only
+  /djinn:status command. Donald's installed copy is a separate cached
+  2.1.0; nothing here is published until he publishes it.
