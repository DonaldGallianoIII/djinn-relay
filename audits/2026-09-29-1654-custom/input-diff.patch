@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+# git pre-push hook: run the private check before any push, so a push made
+# by hand is checked as a review's build_cmd is. Install once per clone:
+#   ln -s ../../tools/pre-push.sh .git/hooks/pre-push
+# It checks the working tree, not history: after a history rewrite, also
+# run the log check in tools/check-private.sh's header before pushing.
+#
+# @interacts  runs tools/check-private.sh; writes nothing
+# @deps       bash, git
+# @complexity O(check-private.sh)
+# @alloc      none
+root=$(git rev-parse --show-toplevel) || exit 1
+exec bash "$root/tools/check-private.sh"
