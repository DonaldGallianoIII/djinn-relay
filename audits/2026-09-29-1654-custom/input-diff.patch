+#!/usr/bin/env bash
+# Fail when this public repo tracks, or is about to commit, anything private:
+# a /djinn:learn run folder or any file shaped like one, a home directory
+# path, or any word on the owner's private pattern list. Commit 32a1c17 put
+# two run folders under docs/examples/, and round 2 of the learn review
+# found a secure item's answer tell and workplace names in audits/; this
+# check stops all three.
+#
+# Four passes, each over every tracked or unignored file:
+#   1. no path under learn/ or local/ is tracked or unignored;
+#   2. the learn marks (the secure README banner, a training row's
+#      source_ref key, and the status every learn file carries) appear only
+#      in the named prompt files that define them and in audits/;
+#   3. no home directory path (/home/<user>/) appears anywhere;
+#   4. no line of local/private-patterns.txt matches anywhere, audits/ and
+#      plugins/ included. That file is gitignored, so the private words it
+#      lists never enter this repo. Missing, the pass is skipped and the
+#      output says so in capitals; present but empty, the check fails.
+# Every git call's exit status is read: a git error fails the check, it
+# never reads as clean. This checks the working tree only. Before pushing
+# a rewritten range, also check its history:
+#   git log -p <pushed>..HEAD | grep -c -i -E -f <the patterns, comments removed>
+# must print 0. tools/pre-push.sh runs this script as a git pre-push hook.
+#
+# @interacts  reads the git index, the working tree, and
+#             local/private-patterns.txt (or the main worktree's copy when
+#             run in a linked worktree); writes one temp file, removed on exit
+# @deps       git, grep, mktemp; no project imports
+# @complexity O(f * b * p): f tracked or unignored files (about 200 today),
+#             b bytes per file (under 400 KB), p patterns (about 50); four
+#             git grep passes
+# @alloc      one temp file of the filtered patterns; git's own buffers
+set -o pipefail
+
+root=$(git rev-parse --show-toplevel) || { echo "private check: FAIL, not inside a git repo" >&2; exit 1; }
+[ -n "$root" ] || { echo "private check: FAIL, git gave no repo root" >&2; exit 1; }
+cd "$root" || exit 1
+
+# The exact banner line learn-synthesis writes first in a secure run's
+# README, fixed in CONTRACTS.md section 13 ("Secure sources"). Change both
+# together.
+BANNER='SECURE SOURCE. Derived from'
+ROW_KEY='"source_ref"'
+DRAFT_STATUS='learn draft, not yet reviewed'
+# The only files allowed to carry the learn marks: the prompts that define
+# them, the QA script that walks them, and this script. audits/ discusses
+# them by name.
+MARK_FILES=(
+  plugins/djinn/CONTRACTS.md
+  plugins/djinn/commands/learn.md
+  plugins/djinn/agents/learn-known.md
+  plugins/djinn/agents/learn-asked.md
+  plugins/djinn/agents/learn-harder.md
+  plugins/djinn/agents/learn-prepare.md
+  plugins/djinn/agents/learn-fact-checker.md
+  plugins/djinn/agents/learn-synthesis.md
+  qa/human/learn-leak-guards.md
+  tools/check-private.sh
+)
+HOME_PATH='/home/[a-z_][a-z0-9_.-]*/'
+PATTERNS_REL='local/private-patterns.txt'
+failed=0
+
+tmp=$(mktemp) || { echo "private check: FAIL, mktemp failed" >&2; exit 1; }
+trap 'rm -f "$tmp"' EXIT
+
+# Run git grep with the given arguments; print matching file names. Exit 0
+# on a match, 1 on none, 2 on a git error (reported here).
+grep_files() {
+  local out rc
+  out=$(git -c core.quotePath=false grep --untracked -l "$@" 2>&1)
+  rc=$?
+  if [ "$rc" -gt 1 ]; then
+    echo "private check: FAIL, git grep exited $rc: $out" >&2
+    return 2
+  fi
+  [ -n "$out" ] && printf '%s\n' "$out"
+  return "$rc"
+}
+
+# Pass 1: learn/ and local/ paths.
+listing=$(git -c core.quotePath=false ls-files --cached --others --exclude-standard)
+rc=$?
+if [ "$rc" -ne 0 ]; then
+  echo "private check: FAIL, git ls-files exited $rc" >&2
+  failed=1
+else
+  paths=$(printf '%s\n' "$listing" | grep -E '(^|/)(learn|local)/')
+  if [ -n "$paths" ]; then
+    echo "private check: learn/ or local/ files are tracked or unignored:" >&2
+    echo "$paths" >&2
+    failed=1
+  fi
+fi
+
+# Pass 2: the learn marks outside the files that define them.
+excludes=(':!audits')
+for f in "${MARK_FILES[@]}"; do excludes+=(":(exclude,literal)$f"); done
+for pattern in "$BANNER" "$ROW_KEY" "$DRAFT_STATUS"; do
+  hits=$(grep_files -F -e "$pattern" -- . "${excludes[@]}")
+  rc=$?
+  if [ "$rc" -eq 2 ]; then
+    failed=1
+  elif [ "$rc" -eq 0 ]; then
+    echo "private check: files carry '$pattern', the mark of a learn run:" >&2
+    echo "$hits" >&2
+    failed=1
+  fi
+done
+
+# Pass 3: home directory paths, everywhere.
+hits=$(grep_files -E -e "$HOME_PATH" -- . ':!tools/check-private.sh')
+rc=$?
+if [ "$rc" -eq 2 ]; then
+  failed=1
+elif [ "$rc" -eq 0 ]; then
+  echo "private check: files carry a home directory path (write ~ instead):" >&2
+  echo "$hits" >&2
+  failed=1
+fi
+
+# Pass 4: the owner's private words, everywhere.
+patterns="$root/$PATTERNS_REL"
+if [ ! -f "$patterns" ]; then
+  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
+  [ -n "$common" ] && [ -f "$common/../$PATTERNS_REL" ] && patterns="$common/../$PATTERNS_REL"
+fi
+if [ ! -f "$patterns" ]; then
+  echo "private check: PRIVATE WORDS NOT CHECKED. $PATTERNS_REL does not exist here or in the main worktree." >&2
+  echo "private check: make it (one extended regex per line, # comments) before any push." >&2
+else
+  grep -v -E '^[[:space:]]*(#|$)' "$patterns" > "$tmp"
+  count=$(wc -l < "$tmp")
+  if [ "$count" -eq 0 ]; then
+    echo "private check: FAIL, $PATTERNS_REL holds no patterns; an empty list checks nothing" >&2
+    failed=1
+  else
+    hits=$(grep_files -i -E -f "$tmp" -- .)
+    rc=$?
+    if [ "$rc" -eq 2 ]; then
+      failed=1
+    elif [ "$rc" -eq 0 ]; then
+      echo "private check: files carry a word from $PATTERNS_REL (the words are not printed):" >&2
+      echo "$hits" >&2
+      failed=1
+    else
+      echo "private check: $count private patterns, 0 hits"
+    fi
+  fi
+fi
+
+if [ "$failed" -ne 0 ]; then
+  echo "private check: FAIL. Move run folders to local/ (gitignored), write ~ for the home folder, and scrub private words before any commit." >&2
+  exit 1
+fi
+echo "private check: clean"
