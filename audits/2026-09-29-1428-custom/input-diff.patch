+#!/usr/bin/env bash
+# Fail when a /djinn:learn run folder, or anything shaped like one, is
+# tracked or about to be committed in this public repo. Commit 32a1c17 put
+# two run folders (a secure exam item and a private repo's quiz) under
+# docs/examples/; this check would have stopped it.
+#
+# @interacts  reads the git index and every tracked or unignored file outside
+#             plugins/ (the plugin's own prompts describe the banner and the
+#             row keys, so they are exempt); writes nothing
+# @deps       git, grep; no project imports
+# @complexity O(f * b): f files outside plugins/ (about 110 today), b bytes
+#             per file (under 60 KB); one git grep pass per pattern, 3 passes
+# @alloc      git's own buffers; nothing retained after exit
+set -o pipefail
+cd "$(git rev-parse --show-toplevel)" || exit 1
+
+BANNER='SECURE SOURCE. Derived from'
+ROW_KEY='"source_ref"'
+failed=0
+
+paths=$(git -c core.quotePath=false ls-files --cached --others --exclude-standard -- ':!plugins' | grep -E '^(learn|local)/' )
+if [ -n "$paths" ]; then
+  echo "private check: learn/ or local/ files are tracked or unignored:" >&2
+  echo "$paths" >&2
+  failed=1
+fi
+
+for pattern in "$BANNER" "$ROW_KEY"; do
+  hits=$(git -c core.quotePath=false grep --untracked -l -F -e "$pattern" -- . ':!plugins' ':!tools/check-private.sh' ':!audits' 2>/dev/null)
+  if [ -n "$hits" ]; then
+    echo "private check: files outside plugins/ and audits/ carry '$pattern', the mark of a learn run:" >&2
+    echo "$hits" >&2
+    failed=1
+  fi
+done
+
+if [ "$failed" -ne 0 ]; then
+  echo "private check: FAIL. Move run folders to local/ (gitignored) and never commit them." >&2
+  exit 1
+fi
+echo "private check: clean"
