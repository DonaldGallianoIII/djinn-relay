+  item_shape: []         # schema docs, item tests and a real bank, e.g. [content/schema/quiz.md, tests/content.test.mjs]
+  writing_rules: []      # e.g. [docs/ITEM-WRITING.md]
+  tiers: []              # your difficulty tiers in order, each a name and what it tests
+  # e.g.
+  #  - name: easy
+  #    tests: the mechanism, what happens and why
+  #  - name: hard
+  #    tests: spot the mistake in a spec, or make the call
+  scenarios: []          # settings items rotate through, each with the file its details come from
+  # e.g.
+  #  - name: clinic
+  #    where: docs/settings/clinic.md
+  secure_paths: []       # inputs from here never leave this repo; [.] for a private repo
+  holdout: []            # source question ids whose rows are eval rows, never train
+  out_dir: learn/        # must resolve inside the repo
+
 # Free text every agent reads as architecture context. State model, event
 # mechanism, render or request loop, anything a new reviewer needs. Link to
 # a doc for detail.
